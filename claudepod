#!/usr/bin/env bash
set -euo pipefail

# claudepod: Launch Claude Code in a sandboxed Podman container.
# Run `claudepod --help` for full usage.

usage() {
  cat <<'EOF'
claudepod: Launch Claude Code in a sandboxed Podman container

Usage:
  claudepod [options] [project-dir] [-- claude-args...]

Options:
  -b, --build        Force rebuild the container image (clean, no layer cache)
  -n, --no-firewall  Skip firewall setup (faster start, less secure)
  -p, --prompt TEXT  Pass a prompt directly (non-interactive, for background tasks)
  -s, --shell        Drop into a shell instead of launching Claude Code
  -r, --resume ID    Resume a specific Claude session by its session ID
  -i, --interactive  Keep Claude's permission prompts (you're present to answer)
  -h, --help         Show this help

Examples:
  claudepod                          # Current dir, interactive
  claudepod ~/projects/myapp         # Specific project
  claudepod -p "fix all lint errors" # Non-interactive task
  claudepod -- --model opus          # Pass args to claude
EOF
}

IMAGE_NAME="claudepod"
CONTAINER_PREFIX="claudepod"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Container user config (must match Dockerfile ARG defaults)
CONTAINER_USER="dev"
CONTAINER_HOME="/home/${CONTAINER_USER}"

# Defaults
FORCE_BUILD=false
USE_FIREWALL=true
CLAUDE_PROMPT=""
SHELL_ONLY=false
RESUME_SESSION_ID=""
INTERACTIVE=false
PROJECT_DIR=""
CLAUDE_EXTRA_ARGS=()
CLAUDE_EXTRA_ARGS_COUNT=0

# Parse arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
  -b | --build)
    FORCE_BUILD=true
    shift
    ;;
  -n | --no-firewall)
    USE_FIREWALL=false
    shift
    ;;
  -s | --shell)
    SHELL_ONLY=true
    shift
    ;;
  -r | --resume)
    if [[ $# -lt 2 ]]; then
      echo "Error: $1 requires a session ID argument" >&2
      exit 1
    fi
    RESUME_SESSION_ID="$2"
    shift 2
    ;;
  -i | --interactive)
    INTERACTIVE=true
    shift
    ;;
  -p | --prompt)
    if [[ $# -lt 2 ]]; then
      echo "Error: $1 requires an argument" >&2
      exit 1
    fi
    CLAUDE_PROMPT="$2"
    shift 2
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  --)
    shift
    CLAUDE_EXTRA_ARGS=("$@")
    CLAUDE_EXTRA_ARGS_COUNT=$#
    break
    ;;
  -*)
    echo "Unknown option: $1" >&2
    exit 1
    ;;
  *)
    PROJECT_DIR="$1"
    shift
    ;;
  esac
done

# Resolve project directory
PROJECT_DIR="${PROJECT_DIR:-$(pwd)}"
PROJECT_DIR="$(cd "$PROJECT_DIR" && pwd)"
PROJECT_NAME="$(basename "$PROJECT_DIR")"

# Refuse paths that would collide with the container user's home (which is a
# named volume mount). A project under /home/dev/ would have its same-path
# mount shadow or be shadowed by the home volume.
if [[ "$PROJECT_DIR" == "$CONTAINER_HOME" || "$PROJECT_DIR" == "$CONTAINER_HOME"/* ]]; then
  echo "Error: project path $PROJECT_DIR collides with the container user's home ($CONTAINER_HOME)." >&2
  echo "Move the project elsewhere on the host." >&2
  exit 1
fi

# Sanitize project name for container naming (alphanumeric, hyphens, underscores only)
SAFE_PROJECT_NAME="$(echo "$PROJECT_NAME" | tr -cd '[:alnum:]-_')"
CONTAINER_NAME="${CONTAINER_PREFIX}-${SAFE_PROJECT_NAME:-project}-$$"

# Per-project Claude state lives in <project>/.claudepod/ on the host and is
# bind-mounted onto the in-container path Claude Code uses for per-project
# state (~/.claude/projects/<escaped-cwd>/, where slashes become dashes).
PROJECT_STATE_DIR="${PROJECT_DIR}/.claudepod"
ESCAPED_CWD="${PROJECT_DIR//\//-}"
CONTAINER_STATE_DIR="${CONTAINER_HOME}/.claude/projects/${ESCAPED_CWD}"

echo "=== Claude Sandbox ==="
echo "  Project:   $PROJECT_DIR (mounted at same path inside container)"
echo "  State:     $PROJECT_STATE_DIR"
echo "  Container: $CONTAINER_NAME"
echo "  Firewall:  $USE_FIREWALL"
echo ""

# ----- Build image if needed -----
VOLUME_NAME="claudepod-home"

image_exists() {
  podman image exists "$IMAGE_NAME" 2>/dev/null
}

if $FORCE_BUILD || ! image_exists; then
  echo "[build]    Building $IMAGE_NAME image..."
  podman build --format docker \
    --no-cache \
    --build-arg USER_UID="$(id -u)" \
    --build-arg USER_GID="$(id -g)" \
    -t "$IMAGE_NAME" \
    "$SCRIPT_DIR"
  echo "[build]    Done."
else
  echo "[build]    Image $IMAGE_NAME exists. Use -b to rebuild."
fi

# ----- Ensure home volume matches current image -----
CURRENT_IMAGE_ID=$(podman image inspect --format '{{.Id}}' "$IMAGE_NAME" 2>/dev/null || echo "")

if podman volume exists "$VOLUME_NAME" 2>/dev/null; then
  STORED_IMAGE_ID=$(podman volume inspect --format '{{index .Labels "image-id"}}' "$VOLUME_NAME" 2>/dev/null || echo "")
  if [ "$STORED_IMAGE_ID" != "$CURRENT_IMAGE_ID" ]; then
    echo "[volume]   Image changed — removing stale home volume... $VOLUME_NAME"
    # --force: stops dependent containers (e.g., zombies from a prior crashed
    # run) before removing the volume. Use || true so a rm failure doesn't
    # trip set -e and silently kill the launcher.
    if ! podman volume rm --force "$VOLUME_NAME" >/dev/null 2>&1; then
      echo "[volume]   Warning: failed to remove $VOLUME_NAME (in use by another container?). Continuing with the existing volume." >&2
    fi
  fi
fi

if ! podman volume exists "$VOLUME_NAME" 2>/dev/null; then
  echo "[volume]   Creating home volume for current image... $VOLUME_NAME"
  if ! podman volume create --label "image-id=$CURRENT_IMAGE_ID" "$VOLUME_NAME" >/dev/null 2>&1; then
    echo "Error: failed to create volume $VOLUME_NAME" >&2
    exit 1
  fi
fi

# ----- Ensure per-project state dir exists and is gitignored -----
if [ ! -d "$PROJECT_STATE_DIR" ]; then
  mkdir -p "$PROJECT_STATE_DIR"
  echo "[state] Created $PROJECT_STATE_DIR"
fi

GITIGNORE="${PROJECT_DIR}/.gitignore"
if [ -f "$GITIGNORE" ] && ! grep -qxF '.claudepod/' "$GITIGNORE"; then
  printf '\n# claudepod sandbox state\n.claudepod/\n' >> "$GITIGNORE"
  echo "[gitignore] Appended .claudepod/ to $GITIGNORE"
fi

# ----- Construct run arguments -----
RUN_ARGS=(
  "--rm"
  "--name" "$CONTAINER_NAME"
  "-it"
  "--userns=keep-id"
  "--workdir" "$PROJECT_DIR"
)

# ----- Construct mount arguments -----
MOUNTS=(
  # Project mounted at the same absolute path as on the host. This avoids
  # path-translation issues with anything git records as an absolute path
  # (worktree pointers, submodules, core.worktree, etc.).
  "-v" "${PROJECT_DIR}:${PROJECT_DIR}:Z"

  # Persist the entire container home directory across sessions
  # Covers ~/.claude.json, ~/.claude/, ~/.bashrc modifications, shell history, etc.
  "-v" "${VOLUME_NAME}:${CONTAINER_HOME}:Z"

  # Per-project Claude state (sessions + memory + plans + todos), bind-mounted
  # onto the path Claude Code uses for per-cwd state. Sub-mount on top of the
  # home volume — podman handles the layering.
  "-v" "${PROJECT_STATE_DIR}:${CONTAINER_STATE_DIR}:Z"
)

# Forward the host's SSH agent instead of mounting private keys. Private keys
# never enter the container; git relies entirely on the forwarded agent. We
# still bind-mount the SSH config, known_hosts, and public keys read-only so
# host-side Host/IdentityFile/proxy settings apply inside the container.
if [ -n "${SSH_AUTH_SOCK:-}" ]; then
  MOUNTS+=("-v" "${SSH_AUTH_SOCK}:/tmp/ssh-agent.sock:Z")
  RUN_ARGS+=("-e" "SSH_AUTH_SOCK=/tmp/ssh-agent.sock")
  echo "[mount] SSH agent socket"

  if [ -f "$HOME/.ssh/config" ]; then
    MOUNTS+=("-v" "${HOME}/.ssh/config:${CONTAINER_HOME}/.ssh/config:ro,Z")
    echo "[mount] ~/.ssh/config (read-only)"
  fi
  if [ -f "$HOME/.ssh/known_hosts" ]; then
    MOUNTS+=("-v" "${HOME}/.ssh/known_hosts:${CONTAINER_HOME}/.ssh/known_hosts:ro,Z")
    echo "[mount] ~/.ssh/known_hosts (read-only)"
  fi
  for pubkey in "$HOME"/.ssh/*.pub; do
    if [ -f "$pubkey" ]; then
      MOUNTS+=("-v" "${pubkey}:${CONTAINER_HOME}/.ssh/$(basename "$pubkey"):ro,Z")
      echo "[mount] ~/.ssh/$(basename "$pubkey") (read-only)"
    fi
  done
fi

# Mount gitconfig read-only
if [ -f "$HOME/.gitconfig" ]; then
  MOUNTS+=("-v" "${HOME}/.gitconfig:${CONTAINER_HOME}/.gitconfig:ro,Z")
fi

# Mount gh CLI config read-only so `gh` works inside the container without a
# separate login. Note: ~/.config/gh/hosts.yml contains OAuth tokens; this
# accepts the same trust trade-off as mounting SSH public keys — the token
# bytes are reachable by anything in the container. Prefer `GH_TOKEN=...` in
# the environment if you want the token out of the mount surface.
if [ -d "$HOME/.config/gh" ]; then
  MOUNTS+=("-v" "${HOME}/.config/gh:${CONTAINER_HOME}/.config/gh:ro,Z")
fi

# Firewall requires NET_ADMIN + NET_RAW capabilities
if $USE_FIREWALL; then
  RUN_ARGS+=("--cap-add=NET_ADMIN" "--cap-add=NET_RAW")
fi

# ----- Detect project version files for mise -----
VERSION_FILES=(.tool-versions .node-version .python-version .ruby-version .go-version .java-version mise.toml .mise.toml)
HAS_VERSION_FILE=false
for vf in "${VERSION_FILES[@]}"; do
  if [ -f "$PROJECT_DIR/$vf" ]; then
    HAS_VERSION_FILE=true
    echo "[mise]     Detected $vf — runtimes will be installed at startup."
    break
  fi
done

MISE_HINT="This environment uses Mise for language runtime management."

# ----- Construct the entrypoint command -----
# We build a bash -c script that references $1, $2, ... for variable values,
# then pass the actual values as positional arguments. This avoids all shell
# escaping issues with prompts, extra args, and system prompt text.
ENTRYPOINT_SCRIPT=""
ENTRYPOINT_ARGS=("_") # $0 placeholder for bash -c
ARG_INDEX=1

# Initialize firewall if enabled
if $USE_FIREWALL; then
  ENTRYPOINT_SCRIPT+="sudo /usr/local/bin/init-firewall.sh && "
fi

# Install mise runtimes if version file detected (cwd is set via --workdir)
if $HAS_VERSION_FILE; then
  ENTRYPOINT_SCRIPT+="mise install && "
fi

if $SHELL_ONLY; then
  ENTRYPOINT_SCRIPT+="bash"
else
  # Build the claude command. Prefix with `nosusp` (a Python PTY proxy that
  # runs claude inside a pseudo-terminal and filters 0x1A/Ctrl+Z out of the
  # stdin byte stream before it reaches claude) so a stray Ctrl+Z can't make
  # claude self-suspend via SIGTSTP. Shell-only mode bypasses this since a
  # shell legitimately wants job control.
  #
  # --dangerously-skip-permissions is the default because the container is
  # the sandbox and unattended runs can't answer permission prompts. Pass
  # -i/--interactive to keep Claude's normal prompts when the user is
  # present. Default is a fresh session; pass -r/--resume <id> to resume a
  # specific previous session by its ID (not automatic, because concurrent
  # claudepods in the same project would otherwise both latch onto the
  # most recent session and stomp each other's appends).
  ENTRYPOINT_SCRIPT+="nosusp claude"
  if ! $INTERACTIVE; then
    ENTRYPOINT_SCRIPT+=" --dangerously-skip-permissions"
  fi
  if [ -n "$RESUME_SESSION_ID" ]; then
    ENTRYPOINT_SCRIPT+=" -r \"\$${ARG_INDEX}\""
    ENTRYPOINT_ARGS+=("$RESUME_SESSION_ID")
    ((ARG_INDEX++))
  fi

  # If no version file, hint Claude about mise availability
  if ! $HAS_VERSION_FILE; then
    ENTRYPOINT_SCRIPT+=" --append-system-prompt \"\$${ARG_INDEX}\""
    ENTRYPOINT_ARGS+=("$MISE_HINT")
    ((ARG_INDEX++))
  fi

  # Append any extra args passed after --
  if [ "$CLAUDE_EXTRA_ARGS_COUNT" -gt 0 ]; then
    for arg in "${CLAUDE_EXTRA_ARGS[@]}"; do
      ENTRYPOINT_SCRIPT+=" \"\$${ARG_INDEX}\""
      ENTRYPOINT_ARGS+=("$arg")
      ((ARG_INDEX++))
    done
  fi

  # If prompt is provided, run non-interactively
  if [ -n "$CLAUDE_PROMPT" ]; then
    ENTRYPOINT_SCRIPT+=" -p \"\$${ARG_INDEX}\""
    ENTRYPOINT_ARGS+=("$CLAUDE_PROMPT")
    ((ARG_INDEX++))
  fi
fi

# ----- Launch -----
if $SHELL_ONLY; then
  echo "[run]      Starting sandboxed shell..."
else
  echo "[run]      Starting sandboxed Claude Code..."
fi

podman run \
  "${RUN_ARGS[@]}" \
  "${MOUNTS[@]}" \
  "$IMAGE_NAME" \
  bash -c "$ENTRYPOINT_SCRIPT" "${ENTRYPOINT_ARGS[@]}"

echo "."
echo ".."
echo "..."
echo "[done]     Container destroyed. Your project files in $PROJECT_DIR are intact."
